{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "geojson"],
    "noEmit": false,
    "outDir": "./dist-types",
    "rootDir": "./src",
    "allowImportingTsExtensions": false,
    "paths": {
      "@firewatch/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../shared" }]
}
