{
  "name": "firewatch",
  "version": "0.1.0",
  "private": true,
  "description": "A Google Maps-style wildfire situational awareness map: active fires, perimeters, smoke, air quality, satellite imagery, heat advisories and fire danger.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace @firewatch/server",
    "dev:web": "npm run dev --workspace @firewatch/web",
    "build": "npm run build --workspace @firewatch/server && npm run build --workspace @firewatch/web",
    "start": "npm run start --workspace @firewatch/server",
    "typecheck": "tsc -b packages/shared packages/server packages/web",
    "lint": "npm run typecheck",
    "test": "npm run test --workspace @firewatch/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
