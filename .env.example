# Firewatch configuration. Every value here is optional — the app runs with
# none of them set, using only keyless public feeds.

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0

# api.weather.gov asks clients to identify themselves. Put a contact address
# here; anonymous clients may be rate-limited or rejected.
FIREWATCH_USER_AGENT="Firewatch/0.1 (you@example.com)"

# --- Optional API keys ----------------------------------------------------
# NASA FIRMS satellite hotspots. Free key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
FIRMS_DATASET=VIIRS_NOAA20_NRT
FIRMS_DAYS=1

# EPA AirNow station observations. Free key: https://docs.airnowapi.org/account/request/
# Without it, the keyless AirNow contour raster layer is still available.
AIRNOW_API_KEY=

# --- Behavior -------------------------------------------------------------
# Set to 1 to surface upstream outages instead of serving the bundled sample
# dataset. Recommended for production deployments.
FIREWATCH_DISABLE_FALLBACK=0

# Cache TTLs in seconds.
CACHE_TTL_INCIDENTS=300
CACHE_TTL_PERIMETERS=600
CACHE_TTL_SMOKE=900
CACHE_TTL_ALERTS=300
CACHE_TTL_AIR_QUALITY=900
